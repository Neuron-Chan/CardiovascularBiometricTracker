<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#FFFFFF"
    tools:context=".Temperature">

    <!-- Page Title -->
    <TextView
        android:id="@+id/title_temperature"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Body Temperature Monitor"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp" />

    <!-- Current Temperature -->
    <TextView
        android:id="@+id/current_temperature_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="36.6°C"
        android:textSize="48sp"
        android:textStyle="bold"
        android:textColor="#FF5722"
        app:layout_constraintTop_toBottomOf="@id/title_temperature"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="24dp" />

    <!-- Temperature Graph Placeholder -->
    <View
        android:id="@+id/temperature_graph"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:background="#E0E0E0"
        android:contentDescription="Temperature Graph Placeholder"
        app:layout_constraintTop_toBottomOf="@id/current_temperature_value"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="24dp" />

    <!-- Statistics Section -->
    <LinearLayout
        android:id="@+id/temperature_stats_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#F5F5F5"
        app:layout_constraintTop_toBottomOf="@id/temperature_graph"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="24dp">

        <!-- Min Temperature -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/min_temperature_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Min"
                android:textSize="14sp"
                android:textColor="#757575" />

            <TextView
                android:id="@+id/min_temperature_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="35.8°C"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000000" />
        </LinearLayout>

        <!-- Max Temperature -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/max_temperature_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Max"
                android:textSize="14sp"
                android:textColor="#757575" />

            <TextView
                android:id="@+id/max_temperature_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="37.8°C"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000000" />
        </LinearLayout>

        <!-- Avg Temperature -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/avg_temperature_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Avg"
                android:textSize="14sp"
                android:textColor="#757575" />

            <TextView
                android:id="@+id/avg_temperature_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="36.6°C"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000000" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

