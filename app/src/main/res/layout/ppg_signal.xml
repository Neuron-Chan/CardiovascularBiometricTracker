<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#FFFFFF"
    tools:context=".PPG">

    <!-- Page Title -->
    <TextView
        android:id="@+id/title_ppg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PPG Monitoring"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp" />

    <!-- Current Status -->
    <TextView
        android:id="@+id/ppg_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Stable Signal"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#4CAF50"
        app:layout_constraintTop_toBottomOf="@id/title_ppg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="24dp" />

    <!-- PPG Graph Placeholder -->
    <View
        android:id="@+id/ppg_graph"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:background="#E0E0E0"
        android:contentDescription="PPG Graph Placeholder"
        app:layout_constraintTop_toBottomOf="@id/ppg_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="24dp" />

    <!-- Statistics Section -->
    <LinearLayout
        android:id="@+id/ppg_stats_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#F5F5F5"
        app:layout_constraintTop_toBottomOf="@id/ppg_graph"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="24dp">

        <!-- Heart Rate -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/ppg_heart_rate_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Heart Rate"
                android:textSize="14sp"
                android:textColor="#757575" />

            <TextView
                android:id="@+id/ppg_heart_rate_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="72 bpm"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000000" />
        </LinearLayout>

        <!-- SpO2 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/ppg_spo2_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SpO₂"
                android:textSize="14sp"
                android:textColor="#757575" />

            <TextView
                android:id="@+id/ppg_spo2_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="98%"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000000" />
        </LinearLayout>

        <!-- Pulse Strength -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/ppg_pulse_strength_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pulse Strength"
                android:textSize="14sp"
                android:textColor="#757575" />

            <TextView
                android:id="@+id/ppg_pulse_strength_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Strong"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000000" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
