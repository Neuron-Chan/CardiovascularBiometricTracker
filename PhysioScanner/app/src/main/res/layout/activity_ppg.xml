<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="#FFFFFF"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Toolbar displaying the title of the screen -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarPPG"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#4F6367"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="PPG Signal"
        app:titleTextColor="#FFFFFF" />

    <LinearLayout
        android:layout_width="376dp"
        android:layout_height="641dp"
        android:background="#B8CCD0"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbarPPG">

        <!-- PPG Chart for live waveform -->
        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/ppg_chart"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginBottom="16dp" />

        <!-- Timestamp Display -->
        <TextView
            android:id="@+id/timestamp_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Timestamp:"
            android:textColor="#000000"
            android:textSize="16sp" />

        <!-- PPG Value Display -->
        <TextView
            android:id="@+id/ppg_value_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="PPG Value:"
            android:textColor="#000000"
            android:textSize="16sp" />

        <!-- Button to navigate to the database (if needed for storing PPG readings) -->
        <Button
            android:id="@+id/view_database_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:backgroundTint="#0D3B64"
            android:text="View PPG Database"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Home Button to return to Main Menu -->
    <Button
        android:id="@+id/home_button"
        android:layout_width="119dp"
        android:layout_height="64dp"
        android:text="Home"
        android:backgroundTint="#B8CCD0"
        android:textColor="#000000"
        app:layout_constraintBottom_toBottomOf="@+id/toolbarPPG"
        app:layout_constraintEnd_toEndOf="@+id/toolbarPPG"
        app:layout_constraintHorizontal_bias="0.95"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/toolbarPPG"
        app:layout_constraintVertical_bias="1.0" />

</androidx.constraintlayout.widget.ConstraintLayout>
